<?xml version="1.0"?>
<package format="3">
  <name>keep_going_arcanain</name>
  <version>0.0.0</version>
  <description>Launch configurations for independent Arcanain navigation processes.</description>
  <maintainer email="shiryu.nakano@gmail.com">nkn4ryu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Add runtime dependencies on node packages when launch files are added. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
