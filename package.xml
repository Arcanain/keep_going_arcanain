<?xml version="1.0"?>
<package format="3">
  <name>keep_going_arcanain</name>
  <version>0.0.0</version>
  <description>Launch configurations for independent Arcanain navigation processes.</description>
  <maintainer email="shiryu.nakano@gmail.com">nkn4ryu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>dwa_planner</exec_depend>
  <exec_depend>pure_pursuit_planner</exec_depend>
  <exec_depend>emcl2</exec_depend>
  <exec_depend>path_smoother</exec_depend>
  <exec_depend>arcanain_simulator</exec_depend>
  <exec_depend>odrive_ros2_control</exec_depend>
  <exec_depend>rtk_judge</exec_depend>
  <exec_depend>gnss_preprocessing</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>lidar_based_obstacle_detection</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
